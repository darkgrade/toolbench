{
    "name": "toolbench",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "bench": "bun bench/start.ts",
        "typecheck:bench": "bun bench/studio-config.ts",
        "dev": "vite",
        "build": "tsc --noEmit -p tsconfig.site.json && vite build && vite build --ssr src/server.tsx --outDir .server && bun scripts/prerender.ts",
        "typecheck": "tsc --noEmit",
        "worker": "bun bench/worker.ts"
    },
    "dependencies": {
        "@fontsource/fragment-mono": "^5.3.0",
        "@kevinschaich/components": "^0.8.2",
        "lucide-react": "^1.72.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@fontsource/public-sans": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "satori": "^0.63.2",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    }
}
